{
  "expo": {
    "name": "Campus Market",
    "slug": "campus-market",
    "scheme": "campusmarket",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sigmobileuiuc.campusmarket",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sigmobileuiuc.campusmarket",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Campus Market uses your photos to show the items you list.",
          "cameraPermission": "Campus Market uses the camera to photograph the items you list.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6938c3e6-08e9-49e7-ab89-bb9ec4243644"
      }
    },
    "owner": "campusmarketcom"
  }
}
